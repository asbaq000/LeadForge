# =====================================================================
#  Threads Lead Scraper - environment
#  Copy to .env and fill in. Never commit .env or service_account.json.
# =====================================================================

# ---- Google Sheets (required) ----
# Path to the Google service-account JSON key file you downloaded.
GOOGLE_SERVICE_ACCOUNT_JSON=./service_account.json
# From the sheet URL: docs.google.com/spreadsheets/d/<THIS_PART>/edit
GOOGLE_SHEET_ID=
# Tab name inside the spreadsheet (created automatically if missing)
GOOGLE_SHEET_TAB=Leads

# ---- Threads session (required) ----
# Persistent Chrome profile. Keeps cookies AND device fingerprint stable
# between runs, which is a meaningful part of not getting flagged.
THREADS_PROFILE_DIR=./auth/profile
# Cookie backup, also used to migrate an older session into the profile.
THREADS_STORAGE_STATE=./auth/threads_state.json
# false = watch the browser work (useful while tuning), true = background
HEADLESS=true

# ---- Browser identity (recommended) ----
# Set these to match where the Threads account actually lives. A US account
# whose browser reports UTC and no proxy is an obvious mismatch.
BROWSER_TIMEZONE=Asia/Karachi
BROWSER_LOCALE=en-US

# ---- Proxy (strongly recommended for account safety) ----
# A residential/mobile proxy in the account's home city. Leave blank to use
# your own connection. Datacenter IPs are heavily penalised by Meta.
# Example: http://gate.provider.com:7000
PROXY_SERVER=
PROXY_USERNAME=
PROXY_PASSWORD=

# ---- Targets ----
DAILY_TARGET=70
