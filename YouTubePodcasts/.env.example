# Copy this file to ".env" and fill in real values. Never commit .env.

# YouTube Data API v3 key -- https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_key_here

# ---- Google Sheets (optional) -------------------------------------------
# Leave these blank to work from the CSV in exports/ only; `run` will just
# skip the Sheets step. Fill them in to also push straight into a spreadsheet.
#
# Path to the Google service-account JSON used for Sheets access.
# Share your spreadsheet with the service account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The spreadsheet to write into: either the long id in the URL between /d/
# and /edit, or just paste the whole URL -- both are accepted.
SPREADSHEET_ID=

# ---- Free LLM chain (optional but strongly recommended) ------------------
# Used to profile each podcast: genre, format, HOST NAME, language, plus a
# second opinion on whether the channel is really a podcast. Without any key
# here you still get every lead and every contact detail, but no host names
# and much weaker genres -- set classify.method: keyword in config.yaml if
# you want that mode deliberately.
#
# Tried in order [groq, gemini, openrouter] -- see config.yaml
# classify.llm_provider_order to change the order. No key here = that
# provider is skipped entirely, not an error.
GROQ_API_KEY=
GEMINI_API_KEY=

# OpenRouter: comma-separated, no spaces needed around the commas. Each key
# becomes its own attempt (openrouter#1, openrouter#2, ...) tried in the
# order listed here. Free keys: https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=
