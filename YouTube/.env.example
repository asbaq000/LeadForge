# Copy this file to ".env" and fill in real values. Never commit .env.

# YouTube Data API v3 key -- https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=your_key_here

# Path to the Google service-account JSON used for Sheets access.
# Share your spreadsheet with the service account's client_email as an Editor.
GOOGLE_SERVICE_ACCOUNT_FILE=service_account.json

# The spreadsheet to write into: the long id in the URL between /d/ and /edit
SPREADSHEET_ID=

# Free LLM chain for real content-type classification (classify.method: llm).
# Tried in order [groq, gemini, openrouter] -- see config.yaml
# classify.llm_provider_order to change the order. No key here = that
# provider is skipped entirely, not an error.
GROQ_API_KEY=
GEMINI_API_KEY=

# OpenRouter: comma-separated, no spaces needed around the commas. Each key
# becomes its own attempt (openrouter#1, openrouter#2, ...) tried in the
# order listed here. Free keys: https://openrouter.ai/settings/keys
OPENROUTER_API_KEYS=
